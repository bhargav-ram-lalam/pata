# ===========================================================================
# Pata Environment Configuration Template — Stage 4
# ===========================================================================

# Security & Authentication
PATA_API_KEYS=pata_dev_key,test_api_key_stage3
PATA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8000
PATA_DEBUG_LOG_PII=false

# Rate Limiting (Token Bucket per API Key — Redis-backed in production)
PATA_RATE_LIMIT_RPS=20.0
PATA_RATE_LIMIT_BURST=40.0

# ---------------------------------------------------------------------------
# Persistence (Stage 4: Postgres + Alembic)
# ---------------------------------------------------------------------------
# Production: PostgreSQL — required for multi-instance deployment
PATA_DATABASE_URL=postgresql+psycopg2://pata_app:pata_pass@localhost:5432/pata
POSTGRES_PASSWORD=pata_pass

# Local dev fallback: SQLite (no external services needed)
# PATA_DATABASE_URL=sqlite:///./pata.db

PATA_PURGE_INTERVAL_SEC=3600
# Set to 0 in multi-replica k8s to use the dedicated CronJob instead

# ---------------------------------------------------------------------------
# Redis (Stage 4: Distributed Rate Limiter / Cache / Circuit Breaker)
# ---------------------------------------------------------------------------
# Production: Redis — required for shared state across replicas
PATA_REDIS_URL=redis://localhost:6379/0

# Local dev: leave blank → all Redis-backed components fall back to in-memory
# PATA_REDIS_URL=

# ---------------------------------------------------------------------------
# Pipeline Confidence Thresholds
# ---------------------------------------------------------------------------
PATA_HIGH_CONF=0.80
PATA_MEDIUM_CONF=0.50

# ---------------------------------------------------------------------------
# LLM Disambiguation Provider (Agent 4)
# ---------------------------------------------------------------------------
PATA_LLM_PROVIDER=anthropic
PATA_LLM_MODEL=claude-haiku-4-5
PATA_LLM_MAX_TOKENS=300
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Overpass API Resilience (Agent 3)
# ---------------------------------------------------------------------------
PATA_OVERPASS_URL=https://overpass-api.de/api/interpreter
PATA_OVERPASS_TIMEOUT_SEC=3.0
PATA_OVERPASS_MAX_RETRIES=2
PATA_OVERPASS_CB_THRESHOLD=3
PATA_OVERPASS_CB_COOLDOWN_SEC=60.0
PATA_OVERPASS_CACHE_TTL_SEC=86400.0

# ---------------------------------------------------------------------------
# API Latency & Concurrency Guardrails
# ---------------------------------------------------------------------------
PATA_REQUEST_TIMEOUT_SEC=5.0
PATA_MAX_BATCH_CONCURRENCY=10

# ---------------------------------------------------------------------------
# Webhook (Stage 4: E-Commerce Correction Notifications)
# ---------------------------------------------------------------------------
# Set to receive signed correction events when a human reviewer submits a fix
PATA_WEBHOOK_URL=
PATA_WEBHOOK_SECRET=changeme_in_production
PATA_WEBHOOK_TIMEOUT_SEC=5.0
